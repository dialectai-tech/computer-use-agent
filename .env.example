# ===================================================
# Computer Use Automation (CUA) Configuration
# ===================================================

# ---------------------------------------------------
# Provider Selection
# ---------------------------------------------------
# Options: claude, openai, or both
PROVIDER=claude

# ---------------------------------------------------
# API Keys
# ---------------------------------------------------

# Anthropic Claude API Key
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------
# Optional: Portkey (for unified gateway)
# ---------------------------------------------------
# Enable if you want to use both providers through Portkey
# Get from: https://app.portkey.ai/
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY_CLAUDE=
PORTKEY_VIRTUAL_KEY_OPENAI=
USE_PORTKEY=false

# ---------------------------------------------------
# Model Configuration
# ---------------------------------------------------

# Claude options: claude-sonnet-4-5, claude-opus-4-5, claude-haiku-4-5
# OpenAI options: computer-use-preview
DEFAULT_MODEL=claude-sonnet-4-5

# Alternative model for comparison mode
COMPARISON_MODEL=computer-use-preview

# ---------------------------------------------------
# Display Settings
# ---------------------------------------------------
DISPLAY_WIDTH=1280
DISPLAY_HEIGHT=720
DISPLAY_NUMBER=1

# ---------------------------------------------------
# Agent Behavior
# ---------------------------------------------------
MAX_ITERATIONS=30
SCREENSHOT_INTERVAL=1.0
ACTION_DELAY=0.5
ENABLE_THINKING=true
THINKING_BUDGET=2048

# ---------------------------------------------------
# Docker Configuration
# ---------------------------------------------------
CONTAINER_NAME=cua-browser
DOCKER_IMAGE=cua-browser:latest
AUTO_START_CONTAINER=true

# ---------------------------------------------------
# VNC Configuration (for viewing agent in action)
# ---------------------------------------------------
ENABLE_VNC=true
VNC_PORT=5900
VNC_PASSWORD=changeme

# ---------------------------------------------------
# Recording Configuration
# ---------------------------------------------------
ENABLE_RECORDING=true
RECORDING_FPS=2
RECORDINGS_DIR=./recordings

# ---------------------------------------------------
# Logging
# ---------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ---------------------------------------------------
# Performance & Optimization
# ---------------------------------------------------
SCREENSHOT_QUALITY=85
SCREENSHOT_FORMAT=png
ENABLE_SCREENSHOT_CACHE=false
MAX_SCREENSHOT_SIZE_MB=2

# ---------------------------------------------------
# Safety & Security
# ---------------------------------------------------
# Comma-separated list of allowed domains (empty = all allowed)
ALLOWED_DOMAINS=
# Enable human confirmation for high-risk actions
REQUIRE_CONFIRMATION=false
# Timeout for individual actions (seconds)
ACTION_TIMEOUT=30
# Timeout for entire session (seconds)
SESSION_TIMEOUT=600
